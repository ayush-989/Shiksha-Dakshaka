# Production Node Environment
NODE_ENV=production
PORT=5000

# Database Connections
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/shiksha_dakshaka
MONGODB_URI=

# Security Config
JWT_SECRET=

# CORS Allowed Origin (The Vercel Frontend URL)
# Example: https://shiksha-dakshaka.vercel.app
CLIENT_URL=

# AI Configuration (Optional, chatbot falls back to mock responses if blank)
OPENAI_API_KEY=

# Compiler Configuration (Optional, online editor falls back to mock compiler if blank)
JUDGE0_API_KEY=

# Cloud Storage Configuration (Highly recommended for Render ephemeral storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
